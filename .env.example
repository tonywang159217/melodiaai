# ============================================
# MelodiaAI - Environment Variables
# ============================================

# ------------ Site ------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MelodiaAI

# ------------ Supabase ------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------ Cloudflare R2 ------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BUCKET_URL=https://pub-xxxx.r2.dev

# ------------ Suno API ------------
SUNO_API_URL=https://api.suno.com
SUNO_API_KEY=

# ------------ Lemon Squeezy ------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ------------ Plan IDs ------------
NEXT_PUBLIC_FREE_PLAN_ID=free
NEXT_PUBLIC_BASIC_PLAN_VARIANT_ID=
NEXT_PUBLIC_PRO_PLAN_VARIANT_ID=
